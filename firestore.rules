rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId;
    }
    function sameOrg(orgId) { return signedIn() && orgId == userOrgId(); }
    function sameExistingOrg() { return signedIn() && resource.data.organizationId == userOrgId(); }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /organizations/{orgId} {
      allow read: if sameOrg(orgId);
      allow create: if signedIn() && orgId == request.resource.data.id && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if sameOrg(orgId);
    }
    match /brands/{brandId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId);
      allow update: if sameExistingOrg() && sameOrg(request.resource.data.organizationId);
      allow delete: if sameExistingOrg();
    }
    match /social_accounts/{accountId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId);
      allow update: if sameExistingOrg() && sameOrg(request.resource.data.organizationId);
      allow delete: if sameExistingOrg();
    }
    match /content/{contentId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId);
      allow update: if sameExistingOrg() && sameOrg(request.resource.data.organizationId);
      allow delete: if sameExistingOrg();
    }
    match /publishing_jobs/{jobId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId);
      allow update: if sameExistingOrg() && sameOrg(request.resource.data.organizationId);
      allow delete: if sameExistingOrg();
    }
    match /publishing_events/{eventId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow create: if sameOrg(request.resource.data.organizationId);
      allow update: if sameExistingOrg() && sameOrg(request.resource.data.organizationId);
      allow delete: if sameExistingOrg();
    }
    match /worker_heartbeats/{workerId} {
      allow read: if sameOrg(resource.data.organizationId);
      allow write: if false;
    }
  }
}