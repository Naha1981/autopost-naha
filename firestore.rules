rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function myUser() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function sameOrgResource() {
      return signedIn() && resource.data.organizationId == myUser().organizationId;
    }
    function sameOrgRequest() {
      return signedIn() && request.resource.data.organizationId == myUser().organizationId;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId;
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if signedIn() && orgId == myUser().organizationId;
      allow create, update, delete: if false;
    }

    match /brands/{brandId} {
      allow read: if sameOrgResource();
      allow create: if sameOrgRequest();
      allow update: if sameOrgResource() && sameOrgRequest();
      allow delete: if sameOrgResource();
    }

    match /social_accounts/{accountId} {
      allow read: if sameOrgResource();
      allow create: if sameOrgRequest();
      allow update: if sameOrgResource() && sameOrgRequest();
      allow delete: if sameOrgResource();
    }

    match /content/{contentId} {
      allow read: if sameOrgResource();
      allow create: if sameOrgRequest();
      allow update: if sameOrgResource() && sameOrgRequest();
      allow delete: if sameOrgResource();
    }

    match /publishing_jobs/{jobId} {
      allow read: if sameOrgResource();
      allow create: if sameOrgRequest();
      allow update: if sameOrgResource() && sameOrgRequest();
      allow delete: if sameOrgResource();
    }

    match /publishing_events/{eventId} {
      allow read: if sameOrgResource();
      allow create: if sameOrgRequest();
      allow update: if sameOrgResource() && sameOrgRequest();
      allow delete: if sameOrgResource();
    }

    match /workers/{workerId} {
      allow read, write: if false;
    }
  }
}