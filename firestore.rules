rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();
    }

    // Brands collection
    match /brands/{brandId} {
      allow read, write: if isAuthenticated();
    }

    // Social accounts collection (Notice: NO social passwords stored here!)
    match /social_accounts/{accountId} {
      allow read, write: if isAuthenticated();
    }

    // Content collection
    match /content/{contentId} {
      allow read, write: if isAuthenticated();
    }

    // Publishing jobs queue
    match /publishing_jobs/{jobId} {
      allow read, write: if isAuthenticated();
    }

    // Publishing events telemetry stream
    match /publishing_events/{eventId} {
      allow read, write: if isAuthenticated();
    }
  }
}
